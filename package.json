{
  "name": "chargeflow-automation",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "NODE_OPTIONS='--import tsx' cucumber-js --config cucumber.cjs",
    "test:dry": "NODE_OPTIONS='--import tsx' cucumber-js --config cucumber.cjs --dry-run",
    "report": "open reports/cucumber-report.html",
    "test:report": "npm test && npm run report",
    "allure:clean": "rm -rf allure-results allure-report",
    "allure:convert": "node scripts/cucumber-to-allure.js",
    "allure:generate": "npx allure generate allure-results --clean -o allure-report",
    "allure:open": "npx allure open allure-report",
    "allure:serve": "npx allure serve allure-results",
    "test:allure": "npm run allure:clean && npm test; npm run allure:convert && npm run allure:generate && npm run allure:open"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^12.5.0",
    "@playwright/test": "^1.57.0",
    "@types/node": "^25.0.3",
    "@wdio/allure-reporter": "^9.22.0",
    "allure-commandline": "^2.36.0",
    "allure-cucumberjs": "^3.4.4",
    "allure-js-commons": "^3.4.4",
    "dotenv": "^17.2.3",
    "playwright": "^1.57.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
